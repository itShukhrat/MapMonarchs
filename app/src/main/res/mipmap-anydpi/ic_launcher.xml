<?xml version="1.0" encoding="utf-8"?>
<!--
  The crown mark, supplied as artwork and split into adaptive layers here.

  Foreground and background are separate on purpose: the launcher masks the
  background to its own shape, so the crown is keyed onto its own transparent
  layer and sized inside the 66dp safe circle rather than being cropped with the
  tile. See ic_launcher_crown_bg.xml.

  TO REVERT to the Sovereign Cell mark, point the three layers back at
  ic_launcher_background / ic_launcher_foreground / ic_launcher_monochrome -
  those files are still in the tree, unmodified.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_crown_bg" />
    <foreground android:drawable="@drawable/ic_launcher_crown_fg" />
    <!-- Themed icons get a flat white silhouette of the same art: the system
         tints monochrome but preserves per-pixel alpha, so handing it the
         colour foreground would produce a washed, uneven mark. -->
    <monochrome android:drawable="@drawable/ic_launcher_crown_mono" />
</adaptive-icon>
