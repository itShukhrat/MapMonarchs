<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Dark launch theme. The wizard default was Theme.Material.Light.NoActionBar,
      which flashed a white window for ~1s on every cold start before Compose drew
      the dark UI. On a dark premium app that flash reads as a bug, so the launch
      window background matches Void (#07090D) exactly.
    -->
    <style name="Theme.MapMonarchs" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/void_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!--
          Android 12 and above ignore windowBackground for the launch frame and
          draw the adaptive icon over windowSplashScreenBackground instead. Left
          unset it fell back to a light default, so the dark launch theme above
          was doing nothing on modern devices - the very frame it exists to fix.
        -->
        <item name="android:windowSplashScreenBackground">@color/void_black</item>
    </style>
</resources>