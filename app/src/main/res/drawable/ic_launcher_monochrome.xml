<?xml version="1.0" encoding="utf-8"?>
<!--
  THE CREST - themed-icon (monochrome) variant.

  Same geometry as ic_launcher_foreground at the crest's 0.94 / 0.70 / 0.44
  proportions. Only the treatment differs.

  WHY IT IS A SEPARATE FILE. Android 13+ tints the monochrome drawable with one
  theme colour but KEEPS per-path alpha, so handing it the colour foreground
  would render the 0.10-alpha glow and the ring hierarchy as several muddy greys
  of a single hue. A themed icon has to be one flat silhouette.

  The glow is dropped entirely (it carries no shape) and everything else is full
  opacity. With colour gone the hierarchy rests on form alone: two strokes and
  one solid core, which is exactly why the crest encodes sovereignty as geometry
  rather than as a drawn symbol.

  Stroke weights are heavier than the colour cut: a flat tint against a themed
  background has none of the contrast that Sovereign-on-obsidian provides.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FFFFFFFF">

    <!-- Outer ring: the frame, and the whole silhouette. -->
    <path
        android:pathData="M54,22.98L80.86,38.49L80.86,69.51L54,85.02L27.14,69.51L27.14,38.49z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.0"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- Mid ring. -->
    <path
        android:pathData="M54,30.9L74.01,42.45L74.01,65.55L54,77.1L33.99,65.55L33.99,42.45z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.4"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- Held ground. Solid, so it reads against the strokes with no colour. -->
    <path
        android:pathData="M54,39.48L66.57,46.74L66.57,61.26L54,68.52L41.43,61.26L41.43,46.74z"
        android:fillColor="#FFFFFFFF" />
</vector>
