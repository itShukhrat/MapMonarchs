<?xml version="1.0" encoding="utf-8"?>
<!--
  THE CREST, as the launcher mark.

  ONE MARK FOR THE WHOLE LAUNCH PATH. Android 12+ draws this adaptive icon as
  the system splash, so it is literally the frame immediately before BrandIntro.
  Any difference between the two is a mark swap the player sees in the first
  second of the product. This file therefore does not carry its own design: it
  is IdentityCrest's geometry, at IdentityCrest's proportions, in BrandIntro's
  settled colours.

  THE PROPORTIONS ARE THE CONTRACT: 0.94 / 0.70 / 0.44 of the unit radius, the
  same three rings drawn by IdentityCrest (ui/components/IdentityCrest.kt) and
  assembled by BrandIntro. They are duplicated here because a VectorDrawable
  cannot call Kotlin, and they must be changed together - if the crest is
  retuned, this follows it, or the launch path silently breaks again.

  WHAT WAS REMOVED AND WHY:
  - The apex node. It was a launcher-only flourish that appears nowhere else in
    the product, which made the icon a near-miss of the crest rather than the
    crest. A detail that exists on exactly one surface is not a brand system.
  - The 0.58 / 0.325 ring ratios, which were tuned in isolation and did not
    match the crest they were meant to announce.

  COLOUR ROLES MATCH BrandIntro's settled frame: unsaturated outer frame,
  Sovereign mid ring, SovereignGlow held core. The outer ring uses Neutral
  rather than SlateEdge - one step up the SAME existing neutral ramp, no new
  colour - because SlateEdge on Obsidian is invisible at 48dp. Weight is
  optically corrected for size; hue and hierarchy are not.

  SAFE ZONE: only the central 66dp circle (radius 33) survives every mask shape.
  The outer ring sits at 31.02 and reaches 32.32 with its stroke.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Held light. The same faint bloom the crest throws when ground is held. -->
    <path
        android:pathData="M54,22.65m-31.35,0a31.35,31.35 0,1 1,62.7 0a31.35,31.35 0,1 1,-62.7 0"
        android:fillColor="#4C8DFF"
        android:fillAlpha="0.10" />

    <!-- Outer ring: the frame. Unsaturated, so the core always wins. -->
    <path
        android:pathData="M54,22.98L80.86,38.49L80.86,69.51L54,85.02L27.14,69.51L27.14,38.49z"
        android:strokeColor="#3A4354"
        android:strokeWidth="2.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- Mid ring: the accent proper, and the only stroke carrying Sovereign. -->
    <path
        android:pathData="M54,30.9L74.01,42.45L74.01,65.55L54,77.1L33.99,65.55L33.99,42.45z"
        android:strokeColor="#4C8DFF"
        android:strokeWidth="3.0"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- Held ground: filled, not stroked. The one solid thing in the mark, as it
         is the one solid thing in the game. -->
    <path
        android:pathData="M54,39.48L66.57,46.74L66.57,61.26L54,68.52L41.43,61.26L41.43,46.74z"
        android:fillColor="#7FB0FF" />
</vector>
