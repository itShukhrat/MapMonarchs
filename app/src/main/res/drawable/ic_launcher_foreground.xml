<?xml version="1.0" encoding="utf-8"?>
<!--
  The crest, as the launcher mark.

  NOT NEW ART: this is the same concentric-hexagon geometry the product already
  speaks in IdentityCrest, BrandIntro, LockMotif and the command dock. The icon
  is the app stating its own shape language rather than a separate logo that
  would have to be kept in sync with it.

  SAFE ZONE: adaptive icons mask the outer 18dp on round and squircle launchers,
  so every visible element sits inside the central 72x72 area - the outer ring
  has a circumradius of 33, well within the 36 limit.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer ring: the frame. -->
    <path
        android:pathData="M82.58,70.5L54,87L25.42,70.5L25.42,37.5L54,21L82.58,37.5z"
        android:strokeColor="#4C8DFF"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.38"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
    <!-- Mid ring: the accent proper. -->
    <path
        android:pathData="M73.92,65.5L54,77L34.08,65.5L34.08,42.5L54,31L73.92,42.5z"
        android:strokeColor="#4C8DFF"
        android:strokeWidth="3"
        android:strokeAlpha="0.85"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
    <!-- Core: held ground. -->
    <path
        android:pathData="M64.39,60L54,66L43.61,60L43.61,48L54,42L64.39,48z"
        android:fillColor="#7FB0FF" />
</vector>
