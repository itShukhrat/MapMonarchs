<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher background is the app surface itself.

  It was the Android Studio wizard green, which meant the very first frame of a
  dark tactical product was a bright green tile - and on Android 12 and above
  the SplashScreen API draws this same adaptive icon, so that green was also the
  first thing shown on every cold start, before any Compose code ran.

  NOW A CENTRE-LIT OBSIDIAN FIELD RATHER THAN FLAT VOID. Same move the map makes
  with its vignette: the board reads as lit from the middle, so the mark sits in
  a pool of light instead of on a dead black square. The falloff is luminance
  only - one hue, no second colour - so the steel and the lit core stay the
  only things the eye ranks. Radius 72 covers the corners (half-diagonal 76) with
  the darkest stop reaching the crop edge on every mask shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="46"
                android:gradientRadius="72">
                <item android:offset="0" android:color="#FF141C28" />
                <item android:offset="0.55" android:color="#FF0B0F16" />
                <item android:offset="1" android:color="#FF07090D" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
